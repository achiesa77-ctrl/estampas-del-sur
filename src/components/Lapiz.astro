---
// Trazo de lápiz graso dorado (spec §2.4): a mano alzada, nunca una
// figura perfecta. `pathLength="1"` permite dibujarlo animando
// stroke-dashoffset de 1 a 0. Por defecto (sin JS) se ve dibujado.
interface Props {
  forma: "circulo" | "subrayado";
  clase?: string;
}

const { forma, clase } = Astro.props;

// El círculo es un lazo irregular: arranca arriba a la izquierda, da la
// vuelta un poco torcido y se pasa del punto de partida, como cuando se
// marca la toma elegida en una hoja de contactos.
const trazos = {
  circulo: {
    viewBox: "0 0 250 150",
    // Lado derecho más abultado, fondo aplanado, un temblor a la izquierda
    // y una segunda pasada que cruza el inicio por fuera y se escapa hacia
    // arriba: así se lee como lápiz graso y no como elipse.
    d: "M62.5 21.2 C115 7.5 185 5 221.2 21.2 C246.2 33.8 256.2 70 240 98.8 C226.2 123.8 177.5 138.8 123.8 137.5 C75 136.2 30 130 15 105 C5 87.5 11.2 72.5 7.5 58.8 C5 45 16.2 33.8 35 27.5 C62.5 16.2 105 7.5 146.2 8.8 C172.5 10 190 13.8 203.8 21.2",
  },
  subrayado: {
    viewBox: "0 0 200 16",
    d: "M3 11 C46 5 117 13 197 6",
  },
} as const;

const { viewBox, d } = trazos[forma];
---

<svg
  class:list={["lapiz", `lapiz--${forma}`, clase]}
  viewBox={viewBox}
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  <path d={d} pathLength="1"></path>
</svg>

<style>
  .lapiz {
    overflow: visible;
    fill: none;
    pointer-events: none;
  }

  .lapiz path {
    fill: none;
    stroke: var(--oro);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    /* Sin vector-effect: non-scaling-stroke — en Chrome rompe el cálculo
       del guion con pathLength y el trazo nunca se cierra. El viewBox está
       dimensionado para que 3 unidades ≈ 3px sobre un cuadro de escritorio;
       el leve estiramiento de preserveAspectRatio="none" da variación de
       presión (más grueso en los costados que arriba y abajo). */
  }
</style>
